<Window x:Class="CarInvoice.Desktop.Views.InvoiceVerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Verify Key Vehicle &amp; Pricing Details"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource BodyFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="pack://application:,,,/CarInvoice;component/Assets/app.ico">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <ui:Button Content="Edit Details" Appearance="Secondary" Click="OnEditClick" Margin="0,0,10,0" Padding="16,8"/>
      <ui:Button Content="Confirm &amp; Generate Invoice" Appearance="Primary" Click="OnConfirmClick" Padding="16,8"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="VERIFY" Style="{StaticResource EyebrowStyle}"/>
        <TextBlock Text="Verify Key Vehicle &amp; Pricing Details" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4"/>
        <TextBlock Text="Confirm these four fields before the Word invoice is generated."
                   Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardSurfaceStyle}" Padding="14" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="CHASSIS" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="ChassisText" Style="{StaticResource MonoPlateStyle}" FontSize="18"/>
            <TextBlock x:Name="MakerText" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <UniformGrid Columns="2">
          <Border Style="{StaticResource VerificationValueCardStyle}">
            <StackPanel>
              <TextBlock Text="COLOR" Style="{StaticResource EyebrowStyle}"/>
              <TextBlock x:Name="ColorText" FontSize="22" FontWeight="Bold"
                         FontFamily="{StaticResource DisplayFont}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource VerificationValueCardStyle}">
            <StackPanel>
              <TextBlock Text="YEAR" Style="{StaticResource EyebrowStyle}"/>
              <TextBlock x:Name="YearText" FontSize="22" FontWeight="Bold"
                         FontFamily="{StaticResource ChassisMonoFont}"
                         Foreground="{StaticResource ChassisHighlightBrush}"
                         Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource VerificationValueCardStyle}">
            <StackPanel>
              <TextBlock Text="ODOMETER" Style="{StaticResource EyebrowStyle}"/>
              <TextBlock x:Name="OdometerText" FontSize="22" FontWeight="Bold"
                         FontFamily="{StaticResource ChassisMonoFont}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource VerificationValueCardStyle}">
            <StackPanel>
              <TextBlock Text="PRICE" Style="{StaticResource EyebrowStyle}"/>
              <TextBlock x:Name="PriceText" FontSize="22" FontWeight="Bold"
                         FontFamily="{StaticResource ChassisMonoFont}"
                         Foreground="{StaticResource ChassisHighlightBrush}"
                         Margin="0,6,0,0"/>
              <TextBlock x:Name="TradeTermText" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
