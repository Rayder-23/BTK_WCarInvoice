<UserControl x:Class="CarInvoice.Desktop.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:CarInvoice.Desktop.Controls"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="{StaticResource BodyFont}">
  <DockPanel>
    <ctrl:PageHeader DockPanel.Dock="Top"
                     Eyebrow="LEDGER"
                     Title="Invoices"
                     Subtitle="Reopen generated Word documents or export the filtered ledger to Excel."/>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <ui:Button DockPanel.Dock="Right" Content="Export Ledger to Excel" Command="{Binding ExportLedgerCommand}"
                 Appearance="Secondary" Margin="8,0,0,0"/>
      <ui:Button DockPanel.Dock="Right" Content="Open .docx" Command="{Binding OpenDocumentCommand}"
                 CommandParameter="{Binding SelectedInvoice}" Margin="8,0,0,0" Appearance="Primary"/>
      <ui:Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}"
                 Appearance="Secondary" Margin="8,0,0,0"/>
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Search invoice #, customer, chassis…"/>
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
               Style="{StaticResource StatusMessageStyle}"/>

    <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
              IsReadOnly="True" MouseDoubleClick="OnRowDoubleClick"
              CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" SortMemberPath="InvoiceNumber" Width="110"/>
        <DataGridTextColumn Header="DATE" Binding="{Binding InvoiceDate, StringFormat=\{0:dd-MMM-yy\}}" SortMemberPath="InvoiceDate" Width="100"/>
        <DataGridTextColumn Header="PORT" Binding="{Binding DestinationPort}" SortMemberPath="DestinationPort" Width="100"/>
        <DataGridTextColumn Header="COUNTRY" Binding="{Binding DestinationCountry}" SortMemberPath="DestinationCountry" Width="100"/>
        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Customer.FullName}" SortMemberPath="Customer.FullName" Width="150"/>
        <DataGridTextColumn Header="CHASSIS" Binding="{Binding Vehicle.ChassisNumber}" SortMemberPath="Vehicle.ChassisNumber" Width="100"/>
        <DataGridTextColumn Header="TERM" Binding="{Binding TradeTerm}" SortMemberPath="TradeTerm" Width="70"/>
        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat=\{0:N0\}}" SortMemberPath="TotalAmount" Width="90"/>
        <DataGridTextColumn Header="CCY" Binding="{Binding Currency}" SortMemberPath="Currency" Width="60"/>
        <DataGridCheckBoxColumn Header="DRAFT" Binding="{Binding IsDraft}" SortMemberPath="IsDraft" Width="60"/>
        <DataGridTextColumn Header="DOCUMENT" Binding="{Binding GeneratedDocPath}" SortMemberPath="GeneratedDocPath" Width="*">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock" BasedOn="{StaticResource PathTextStyle}">
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="Margin" Value="4,0"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
