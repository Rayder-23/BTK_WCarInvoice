<UserControl x:Class="CarInvoice.Desktop.Views.CreateInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:CarInvoice.Desktop.Controls"
             xmlns:beh="clr-namespace:CarInvoice.Desktop.Behaviors"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="{StaticResource BodyFont}"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             PreviewMouseWheel="OnPreviewMouseWheel">
  <DockPanel>
    <ctrl:PageHeader DockPanel.Dock="Top"
                     Eyebrow="CREATE"
                     Title="Create Invoice"
                     Subtitle="MDK-style export invoice — chassis plate, destination, consignee, then Word .docx."/>

    <!-- Source bar -->
    <Border DockPanel.Dock="Top" Style="{StaticResource CardSurfaceStyle}" Padding="12,10" Margin="0,0,0,12">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" Text="SOURCE" Style="{StaticResource ToolbarCaptionStyle}" Margin="0,0,10,0"/>

        <Border DockPanel.Dock="Right"
                Style="{StaticResource SuccessBadgeStyle}"
                Padding="10,5"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Cursor="Hand"
                ToolTip="{Binding OutlookStatusToolTip}"
                Visibility="{Binding IsClassicOutlookReady, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonUp="OnOutlookBadgeClick">
          <TextBlock Text="{Binding OutlookStatusLabel}"
                     Foreground="{StaticResource SuccessTextBrush}"
                     FontFamily="{StaticResource BodyFont}"
                     FontSize="11" FontWeight="SemiBold"/>
        </Border>
        <Border DockPanel.Dock="Right"
                Style="{StaticResource WarningBannerStyle}"
                Padding="10,5"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Cursor="Hand"
                ToolTip="{Binding OutlookStatusToolTip}"
                Visibility="{Binding IsOfflineOutlookMode, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonUp="OnOutlookBadgeClick">
          <TextBlock Text="{Binding OutlookStatusLabel}"
                     Foreground="{StaticResource WarningTextBrush}"
                     FontFamily="{StaticResource BodyFont}"
                     FontSize="11" FontWeight="SemiBold"/>
        </Border>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Content="Load from Outlook" Icon="{ui:SymbolIcon Mail24}" Appearance="Primary"
                     Command="{Binding LoadFromOutlookCommand}" Margin="0,0,8,0"
                     ToolTip="Requires Classic Outlook already running (never auto-started)"/>
          <ui:Button Content="Paste Email Text" Icon="{ui:SymbolIcon ClipboardPaste24}"
                     Appearance="Secondary"
                     Command="{Binding PasteEmailTextCommand}" Margin="0,0,8,0"/>
          <ui:Button Content="Drop .msg/.eml" Icon="{ui:SymbolIcon DocumentArrowDown24}"
                     Appearance="Secondary"
                     Command="{Binding DropMessageFileCommand}" Margin="0,0,8,0"/>
          <ui:Button Content="Import from Excel" Icon="{ui:SymbolIcon DocumentTable24}"
                     Appearance="Secondary"
                     Command="{Binding ImportExcelRowCommand}" Margin="0,0,8,0"/>
          <ui:Button Content="Clear / Manual Entry" Icon="{ui:SymbolIcon Eraser24}"
                     Command="{Binding ClearFormCommand}" Appearance="Secondary"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Bottom actions -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardSurfaceStyle}" Padding="12,10" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal">
        <ui:Button Content="Save Draft" Command="{Binding SaveDraftCommand}" Appearance="Secondary" Margin="0,0,8,0"/>
        <ui:Button Content="Generate Word (.docx)" Command="{Binding GenerateWordDocCommand}"
                   Margin="0,0,8,0" Appearance="Primary"/>
        <ui:Button Content="Generate &amp; Open Word" Command="{Binding GenerateAndOpenCommand}"
                   Appearance="Secondary" Margin="0,0,8,0"/>
        <ui:Button Content="Email Invoice" Command="{Binding CreateOutlookDraftCommand}"
                   Appearance="Secondary"/>
      </StackPanel>
    </Border>

    <!-- Semantic status banner (above action bar) -->
    <Border DockPanel.Dock="Bottom"
            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"
            Margin="0,8,0,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource StatusBannerStyle}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
              <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}"/>
              <Setter Property="BorderBrush" Value="{StaticResource SuccessTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusSeverity}" Value="Warning">
              <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
              <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusSeverity}" Value="Error">
              <Setter Property="Background" Value="{StaticResource DangerBackgroundBrush}"/>
              <Setter Property="BorderBrush" Value="{StaticResource DangerTextBrush}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel LastChildFill="True">
        <!-- Compact open actions (success only), right-aligned -->
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Visibility="{Binding ShowGenerationActions, Converter={StaticResource BoolToVis}}">
          <Button Style="{StaticResource StatusIconButtonStyle}"
                  ToolTip="Open folder"
                  Command="{Binding OpenGeneratedFolderCommand}">
            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16"
                           Foreground="{StaticResource SuccessTextBrush}"/>
          </Button>
          <Button Style="{StaticResource StatusIconButtonStyle}"
                  ToolTip="Open invoice"
                  Command="{Binding OpenGeneratedInvoiceCommand}">
            <ui:SymbolIcon Symbol="Document24" FontSize="16"
                           Foreground="{StaticResource SuccessTextBrush}"/>
          </Button>
        </StackPanel>

        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource StatusMessageStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding StatusSeverity}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding StatusSeverity}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- Path in Consolas so \ stays a slash (Yu Gothic renders it as ¥) -->
          <TextBlock Text="{Binding LastGeneratedPathDisplay}"
                     Style="{StaticResource PathTextStyle}"
                     Foreground="{StaticResource SuccessTextBrush}"
                     Margin="0,4,0,0"
                     Visibility="{Binding ShowGenerationActions, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
      <StackPanel>
        <!-- Invoice & Destination | Customer & Consignee -->
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}" Margin="0,0,6,0" Padding="14">
            <StackPanel>
              <ctrl:SectionHeader Eyebrow="INVOICE" Title="Invoice &amp; Destination"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,6,10">
                  <TextBlock Text="Invoice No" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Leave blank to auto-generate INV-YYYY-####"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}"/>
                  <DatePicker SelectedDate="{Binding InvoiceDate}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,6,10">
                  <TextBlock Text="Port" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding DestinationPort, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Country" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding DestinationCountry, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,6,0">
                  <TextBlock Text="Trade Term" Style="{StaticResource FieldLabelStyle}"/>
                  <ComboBox ItemsSource="{Binding TradeTerms}" SelectedItem="{Binding TradeTerm}" IsEditable="True"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,0">
                  <TextBlock Text="Price *" Style="{StaticResource FieldLabelStyle}"/>
                  <DockPanel>
                    <ComboBox DockPanel.Dock="Left"
                              Width="88"
                              Margin="0,0,6,0"
                              ItemsSource="{Binding Currencies}"
                              Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              ToolTip="Invoice currency — enter the amount already converted; no FX rate is applied"/>
                    <Border CornerRadius="6" Padding="2">
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource RequiredFieldHighlightStyle}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding PriceFieldWarning}" Value="True">
                              <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                              <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBox Text="{Binding PriceAmount, UpdateSourceTrigger=PropertyChanged}"
                               beh:NumericInput.Kind="Decimal"
                               FontFamily="{StaticResource ChassisMonoFont}"
                               Foreground="{StaticResource ChassisHighlightBrush}"/>
                    </Border>
                  </DockPanel>
                </StackPanel>
              </Grid>
              <TextBlock Text="Bank Profile" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/>
              <ComboBox ItemsSource="{Binding BankProfiles}"
                        SelectedItem="{Binding SelectedBankProfile}"
                        DisplayMemberPath="ProfileName"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource CardSurfaceStyle}" Margin="6,0,0,0" Padding="14">
            <StackPanel>
              <ctrl:SectionHeader Eyebrow="BUYER" Title="Customer &amp; Consignee"/>
              <TextBlock Text="Customer Name *" Style="{StaticResource FieldLabelStyle}"/>
              <Border Margin="0,0,0,10" CornerRadius="6" Padding="2">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource RequiredFieldHighlightStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CustomerNameWarning}" Value="True">
                        <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
              </Border>
              <TextBlock Text="Customer Address" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox Text="{Binding CustomerAddress, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" Height="52" TextWrapping="Wrap" Margin="0,0,0,10"
                       PreviewMouseWheel="OnChildPreviewMouseWheel"/>
              <CheckBox Content="Consignee same as Customer"
                        IsChecked="{Binding IsConsigneeSameAsCustomer}"
                        Margin="0,0,0,10"
                        FontFamily="{StaticResource BodyFont}"
                        Foreground="{StaticResource TextPrimaryBrush}"/>
              <TextBlock Text="Consignee Name" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox Text="{Binding ConsigneeName, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding IsConsigneeSameAsCustomer, Converter={StaticResource InverseBool}}"
                       Margin="0,0,0,10"/>
              <TextBlock Text="Consignee Address" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox Text="{Binding ConsigneeAddress, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding IsConsigneeSameAsCustomer, Converter={StaticResource InverseBool}}"
                       AcceptsReturn="True" Height="52" TextWrapping="Wrap"
                       PreviewMouseWheel="OnChildPreviewMouseWheel"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Vehicle specifications with chassis plate -->
        <Border Style="{StaticResource CardSurfaceStyle}" Margin="0,0,0,12" Padding="14">
          <StackPanel>
            <ctrl:SectionHeader Eyebrow="VEHICLE" Title="Vehicle Specifications"/>

            <Border Style="{StaticResource ChassisPlateCardStyle}" Margin="0,0,0,12" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="CHASSIS PLATE" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="1" Margin="0,0,8,0">
                  <TextBlock Text="Chassis Code *" Style="{StaticResource FieldLabelStyle}"/>
                  <Border CornerRadius="6" Padding="2">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource RequiredFieldHighlightStyle}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ChassisCodeWarning}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBox Text="{Binding ChassisCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ChassisTextBoxStyle}"/>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,0">
                  <TextBlock Text="Chassis Number *" Style="{StaticResource FieldLabelStyle}"/>
                  <Border CornerRadius="6" Padding="2">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource RequiredFieldHighlightStyle}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ChassisNumberWarning}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBox Text="{Binding ChassisNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ChassisTextBoxStyle}"/>
                  </Border>
                </StackPanel>
                <Border Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom"
                        Style="{StaticResource SuccessBadgeStyle}">
                  <TextBlock Text="{Binding LookupBadge}"
                             Style="{StaticResource BannerTextStyle}"
                             Foreground="{StaticResource SuccessTextBrush}"
                             VerticalAlignment="Center" MaxWidth="220"/>
                </Border>
              </Grid>
            </Border>

            <Border Style="{StaticResource DangerBannerStyle}" Margin="0,0,0,12"
                    Visibility="{Binding HasDuplicate, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding DuplicateWarning}"
                         Style="{StaticResource BannerTextStyle}"
                         Foreground="{StaticResource DangerTextBrush}"/>
            </Border>

            <!-- Multi-model chassis picker -->
            <Border Style="{StaticResource MultiModelPickerStyle}"
                    Visibility="{Binding RequiresModelSelection, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="Multiple Models Found for Chassis Code"
                           Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                <TextBlock Text="Select the correct make/model to auto-fill CC, body, doors, and fuel."
                           Style="{StaticResource MutedTextStyle}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding ChassisModelOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource MultiModelOptionButtonStyle}"
                              Command="{Binding DataContext.SelectChassisModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold"
                                     FontFamily="{StaticResource BodyFont}"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                          <TextBlock Text="{Binding RecommendationBadge}"
                                     Style="{StaticResource EyebrowStyle}" Margin="0,4,0,0"
                                     Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource WarningBannerStyle}" Margin="0,0,0,12"
                    Visibility="{Binding VerificationPrompt, Converter={StaticResource NullOrEmptyToVis}}">
              <TextBlock Text="{Binding VerificationPrompt}"
                         Style="{StaticResource BannerTextStyle}"
                         Foreground="{StaticResource WarningTextBrush}"/>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Margin="0,0,8,10">
                <TextBlock Text="Stock No" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding StockNumber, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,10">
                <TextBlock Text="Make" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding Make, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,8,10">
                <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Margin="0,0,0,10">
                <TextBlock Text="CC" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding EngineCapacityCc, UpdateSourceTrigger=PropertyChanged}"
                         beh:NumericInput.Kind="Integer"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Margin="0,0,8,10">
                <TextBlock Text="Color *" Style="{StaticResource FieldLabelStyle}"/>
                <Border CornerRadius="6" Padding="2">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RequiredFieldHighlightStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ColorFieldWarning}" Value="True">
                          <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                          <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <ComboBox IsEditable="True"
                            ItemsSource="{Binding ColorSuggestions}"
                            Text="{Binding ExteriorColor, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,10">
                <TextBlock Text="Year *" Style="{StaticResource FieldLabelStyle}"/>
                <Border CornerRadius="6" Padding="2">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RequiredFieldHighlightStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding YearFieldWarning}" Value="True">
                          <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                          <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBox Text="{Binding ManufacturingYear, UpdateSourceTrigger=PropertyChanged}"
                           beh:NumericInput.Kind="Integer"/>
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,10">
                <TextBlock Text="Odometer *" Style="{StaticResource FieldLabelStyle}"/>
                <Border CornerRadius="6" Padding="2">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RequiredFieldHighlightStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding MileageFieldWarning}" Value="True">
                          <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                          <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="72"
                              ItemsSource="{Binding MileageUnits}" SelectedItem="{Binding MileageUnit}"/>
                    <TextBox Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged}"
                             beh:NumericInput.Kind="Integer"
                             Margin="0,0,6,0"/>
                  </DockPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,10">
                <TextBlock Text="Doors" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding Doors, UpdateSourceTrigger=PropertyChanged}"
                         beh:NumericInput.Kind="Integer"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,0,8,10">
                <TextBlock Text="Condition" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition}"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,10">
                <TextBlock Text="Steering" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox ItemsSource="{Binding SteeringOptions}" SelectedItem="{Binding Steering}"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,8,10">
                <TextBlock Text="Engine No." Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding EngineNumber, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ChassisTextBoxStyle}" FontSize="13"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,10">
                <TextBlock Text="Seats" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding Seats, UpdateSourceTrigger=PropertyChanged}"
                         beh:NumericInput.Kind="Integer"/>
              </StackPanel>

              <StackPanel Grid.Row="3" Margin="0,0,8,0">
                <TextBlock Text="Body" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox ItemsSource="{Binding BodyTypes}" SelectedItem="{Binding BodyType}" IsEditable="True"/>
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Fuel" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox ItemsSource="{Binding FuelTypes}" SelectedItem="{Binding FuelType}" IsEditable="True"/>
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Unladen Weight (KG)" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding UnladenWeightKg, UpdateSourceTrigger=PropertyChanged}"
                         beh:NumericInput.Kind="Integer"/>
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="3" Margin="0,0,0,0">
                <TextBlock Text="{Binding Currency, StringFormat=Total ({0})}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding TotalAmount, StringFormat=N0, Mode=OneWay}" IsReadOnly="True" FontWeight="Bold"
                         FontFamily="{StaticResource ChassisMonoFont}"
                         Foreground="{StaticResource ChassisHighlightBrush}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="History Notes" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/>
            <TextBox Text="{Binding HistoryNotes, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="48" TextWrapping="Wrap"
                     HorizontalAlignment="Stretch"
                     PreviewMouseWheel="OnChildPreviewMouseWheel"/>
          </StackPanel>
        </Border>

        <!-- JP → EN raw source: collapsed by default -->
        <Border Style="{StaticResource CardSurfaceStyle}" Margin="0,0,0,4" Padding="14,10">
          <Expander IsExpanded="False"
                    Style="{StaticResource SourceTextExpanderStyle}"
                    HorizontalContentAlignment="Stretch">
            <Expander.Header>
              <Grid Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="3" Height="28" Margin="0,0,10,0"
                        Background="{StaticResource ChassisHighlightBrush}"
                        CornerRadius="1" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="JP → EN" Style="{StaticResource EyebrowStyle}" Margin="0"/>
                  <TextBlock Text="Raw email / auction text"
                             Style="{StaticResource SectionTitleStyle}"
                             FontSize="15"/>
                </StackPanel>
              </Grid>
            </Expander.Header>

            <Grid Margin="13,12,0,0" HorizontalAlignment="Stretch">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="Paste or drop source text, then translate mapped Japanese terms."
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"/>
                <ui:Button DockPanel.Dock="Right"
                           Content="Translate JP → EN"
                           Command="{Binding TranslateJapaneseCommand}"
                           Appearance="Primary"
                           HorizontalAlignment="Right"/>
              </DockPanel>
              <TextBox x:Name="RawSourceTextBox"
                       Grid.Row="1"
                       Text="{Binding RawSourceText, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource SourceMonoTextBoxStyle}"
                       HorizontalAlignment="Stretch"
                       PreviewMouseWheel="OnChildPreviewMouseWheel"/>
            </Grid>
          </Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
