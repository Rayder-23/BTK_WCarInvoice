<UserControl x:Class="CarInvoice.Desktop.Views.CreateInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:CarInvoice.Desktop.Controls"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="{StaticResource BodyFont}"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             PreviewMouseWheel="OnPreviewMouseWheel">
  <DockPanel>
    <ctrl:PageHeader DockPanel.Dock="Top"
                     Eyebrow="伝票作成  ·  CREATE"
                     Title="Create Invoice"
                     Subtitle="Pull from Outlook or auction sheets, normalize the chassis plate, then generate the Word 納品書."/>

    <!-- Source bar -->
    <Border DockPanel.Dock="Top" Style="{StaticResource CardSurfaceStyle}" Padding="12,10" Margin="0,0,0,12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="SOURCE" Style="{StaticResource ToolbarCaptionStyle}"/>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Load from Outlook" Icon="{ui:SymbolIcon Mail24}" Appearance="Primary"
                     Command="{Binding LoadFromOutlookCommand}" Margin="0,0,8,0"/>
          <ui:Button Content="Drop .msg/.eml" Icon="{ui:SymbolIcon DocumentArrowDown24}"
                     Appearance="Secondary"
                     Command="{Binding DropMessageFileCommand}" Margin="0,0,8,0"/>
          <ui:Button Content="Import from Excel" Icon="{ui:SymbolIcon DocumentTable24}"
                     Appearance="Secondary"
                     Command="{Binding ImportExcelRowCommand}" Margin="0,0,8,0"/>
          <ui:Button Content="Clear / Manual Entry" Icon="{ui:SymbolIcon Eraser24}"
                     Command="{Binding ClearFormCommand}" Appearance="Secondary"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Bottom actions -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardSurfaceStyle}" Padding="12,10" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <ui:Button Content="Save Draft" Command="{Binding SaveDraftCommand}" Appearance="Secondary" Margin="0,0,8,0"/>
        <ui:Button Content="Generate Word (.docx)" Command="{Binding GenerateWordDocCommand}"
                   Margin="0,0,8,0" Appearance="Primary"/>
        <ui:Button Content="Generate &amp; Open Word" Command="{Binding GenerateAndOpenCommand}"
                   Appearance="Secondary" Margin="0,0,8,0"/>
        <ui:Button Content="Create Outlook Draft with Attachment" Command="{Binding CreateOutlookDraftCommand}"
                   Appearance="Secondary"/>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
               Style="{StaticResource StatusMessageStyle}"/>

    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
      <StackPanel>
        <!-- Chassis plate card -->
        <Border Style="{StaticResource ChassisPlateCardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
              <TextBlock Text="車台番号  ·  CHASSIS PLATE" Style="{StaticResource EyebrowStyle}"/>
              <TextBlock Text="Identify the vehicle" Style="{StaticResource SectionTitleStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Text="型式  ·  Chassis Code" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox Text="{Binding ChassisCode, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource ChassisTextBoxStyle}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,0">
              <TextBlock Text="番号  ·  Chassis Number" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox Text="{Binding ChassisNumber, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource ChassisTextBoxStyle}"/>
            </StackPanel>
            <Border Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom"
                    Style="{StaticResource SuccessBadgeStyle}">
              <TextBlock Text="{Binding LookupBadge}"
                         Style="{StaticResource BannerTextStyle}"
                         Foreground="{StaticResource SuccessTextBrush}"
                         VerticalAlignment="Center" MaxWidth="220"/>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="3"
                    Style="{StaticResource DangerBannerStyle}"
                    Visibility="{Binding HasDuplicate, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding DuplicateWarning}"
                         Style="{StaticResource BannerTextStyle}"
                         Foreground="{StaticResource DangerTextBrush}"/>
            </Border>
          </Grid>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Raw JP / EN text -->
          <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}" Margin="0,0,8,0" Padding="14">
            <DockPanel>
              <ctrl:SectionHeader DockPanel.Dock="Top"
                                  Eyebrow="原文  ·  SOURCE TEXT"
                                  Title="Raw Email / Excel">
                <ctrl:SectionHeader.TrailingContent>
                  <ui:Button Content="Translate JP → EN" Command="{Binding TranslateJapaneseCommand}" Appearance="Primary"/>
                </ctrl:SectionHeader.TrailingContent>
              </ctrl:SectionHeader>
              <TextBox x:Name="RawSourceTextBox"
                       Text="{Binding RawSourceText, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       FontFamily="{StaticResource ChassisMonoFont}" FontSize="12.5"
                       MinHeight="280" MaxHeight="480"
                       Background="{StaticResource AppBackgroundBrush}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       BorderBrush="{StaticResource BorderSubtleBrush}"
                       PreviewMouseWheel="OnChildPreviewMouseWheel"/>
            </DockPanel>
          </Border>

          <!-- Structured fields -->
          <Border Grid.Column="1" Style="{StaticResource CardSurfaceStyle}" Margin="8,0,0,0" Padding="14">
            <StackPanel>
              <ctrl:SectionHeader Eyebrow="顧客  ·  BUYER" Title="Customer"/>
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,6,10">
                  <TextBlock Text="Full Name" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Company" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,6,10">
                  <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding CustomerEmail, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                  <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding CustomerAddress, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </Grid>

              <ctrl:SectionHeader Eyebrow="車両  ·  VEHICLE" Title="Vehicle Details"/>
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,6,10">
                  <TextBlock Text="Make" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding Make, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,6,10">
                  <TextBlock Text="Grade / Trim" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding GradeTrim, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Year" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding ManufacturingYear, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,6,10">
                  <TextBlock Text="Engine Cc" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding EngineCapacityCc, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Color" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding ExteriorColor, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,0,6,10">
                  <TextBlock Text="Fuel" Style="{StaticResource FieldLabelStyle}"/>
                  <ComboBox ItemsSource="{Binding FuelTypes}" SelectedItem="{Binding FuelType}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Transmission" Style="{StaticResource FieldLabelStyle}"/>
                  <ComboBox ItemsSource="{Binding Transmissions}" SelectedItem="{Binding Transmission}"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Margin="0,0,6,10">
                  <TextBlock Text="Mileage" Style="{StaticResource FieldLabelStyle}"/>
                  <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="80" ItemsSource="{Binding MileageUnits}" SelectedItem="{Binding MileageUnit}"/>
                    <TextBox Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                  </DockPanel>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Auction Grade" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding AuctionGrade, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="History Notes  ·  修復歴" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox Text="{Binding HistoryNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                       Height="72" TextWrapping="Wrap" Margin="0,0,0,18"
                       PreviewMouseWheel="OnChildPreviewMouseWheel"/>

              <ctrl:SectionHeader Eyebrow="金額  ·  PRICING" Title="Sale &amp; Tax"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,6,10">
                  <TextBlock Text="Sale Price" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Tax" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding TaxAmount, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,6,10">
                  <TextBlock Text="Additional Fees" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding AdditionalFees, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Total" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding TotalAmount}" IsReadOnly="True" FontWeight="Bold"
                           FontFamily="{StaticResource ChassisMonoFont}"
                           Foreground="{StaticResource ChassisHighlightBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,6,10">
                  <TextBlock Text="Currency" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,10">
                  <TextBlock Text="Payment Method" Style="{StaticResource FieldLabelStyle}"/>
                  <TextBox Text="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="Invoice Notes" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,5"/>
              <TextBox Text="{Binding InvoiceNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56"
                       TextWrapping="Wrap" PreviewMouseWheel="OnChildPreviewMouseWheel"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
