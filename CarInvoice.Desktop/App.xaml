<Application x:Class="CarInvoice.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:CarInvoice.Desktop.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light"/>
        <ui:ControlsDictionary/>
        <!-- Shaken & Washi overrides Wpf.Ui defaults globally -->
        <ResourceDictionary Source="Themes/JapaneseTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
      <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
