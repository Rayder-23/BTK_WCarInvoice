<UserControl x:Class="CarInvoice.Desktop.Controls.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Margin="0,2,0,6">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Ruri ink tick -->
    <Border Grid.RowSpan="2" Width="3" Margin="0,1,8,1"
            Background="{StaticResource ChassisHighlightBrush}"
            CornerRadius="1"
            VerticalAlignment="Stretch"/>

    <DockPanel Grid.Column="1" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left"
                 Text="{Binding Eyebrow, ElementName=Root}"
                 Style="{StaticResource EyebrowStyle}"
                 VerticalAlignment="Bottom"
                 Margin="0,0,8,1"
                 Visibility="{Binding Eyebrow, ElementName=Root, Converter={StaticResource NullOrEmptyToVis}}"/>
      <TextBlock Text="{Binding Title, ElementName=Root}"
                 Style="{StaticResource SectionTitleStyle}"
                 VerticalAlignment="Bottom"/>
    </DockPanel>

    <ContentPresenter Grid.Column="2" Grid.RowSpan="2"
                      Content="{Binding TrailingContent, ElementName=Root}"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>

    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
            Style="{StaticResource SectionRuleStyle}"
            Margin="0,5,0,0"/>
  </Grid>
</UserControl>
