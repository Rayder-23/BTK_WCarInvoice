<UserControl x:Class="CarInvoice.Desktop.Controls.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Margin="0,4,0,10">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Ruri ink tick -->
    <Border Grid.RowSpan="2" Width="3" Margin="0,2,10,2"
            Background="{StaticResource ChassisHighlightBrush}"
            CornerRadius="1"
            VerticalAlignment="Stretch"/>

    <StackPanel Grid.Column="1">
      <TextBlock Text="{Binding Eyebrow, ElementName=Root}"
                 Style="{StaticResource EyebrowStyle}"
                 Visibility="{Binding Eyebrow, ElementName=Root, Converter={StaticResource NullOrEmptyToVis}}"/>
      <TextBlock Text="{Binding Title, ElementName=Root}"
                 Style="{StaticResource SectionTitleStyle}"/>
    </StackPanel>

    <ContentPresenter Grid.Column="2" Grid.RowSpan="2"
                      Content="{Binding TrailingContent, ElementName=Root}"
                      VerticalAlignment="Center" Margin="12,0,0,0"/>

    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
            Style="{StaticResource SectionRuleStyle}"
            Margin="0,8,0,0"/>
  </Grid>
</UserControl>
