<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       Shaken & Washi — Japanese Automotive palette
       ============================================================ -->

  <!-- Colors -->
  <Color x:Key="AppBackgroundColor">#F7F6F2</Color>          <!-- Gofun-iro -->
  <Color x:Key="CardSurfaceColor">#FFFFFF</Color>            <!-- Shiro-neri -->
  <Color x:Key="BorderSubtleColor">#DCD9D0</Color>           <!-- Suna-iro -->
  <Color x:Key="SidebarBackgroundColor">#1B2A4A</Color>      <!-- Kachi-iro -->
  <Color x:Key="SidebarGradientMidColor">#243A62</Color>
  <Color x:Key="SidebarGradientHighlightColor">#2B4C7E</Color> <!-- Ai wash -->
  <Color x:Key="SidebarGradientDeepColor">#121C33</Color>
  <Color x:Key="PrimaryAccentColor">#2B4C7E</Color>          <!-- Ai-iro -->
  <Color x:Key="PrimaryAccentHoverColor">#1F385E</Color>
  <Color x:Key="SelectionTintColor">#E8F0F8</Color>          <!-- Asagi-iro -->
  <Color x:Key="ChassisHighlightColor">#1D5B9E</Color>       <!-- Ruri-iro -->
  <Color x:Key="DangerTextColor">#C83E37</Color>             <!-- Shu-iro -->
  <Color x:Key="DangerBackgroundColor">#FDECEC</Color>
  <Color x:Key="SuccessTextColor">#2E6F40</Color>            <!-- Tokiwa-iro -->
  <Color x:Key="SuccessBackgroundColor">#EAF5EE</Color>
  <Color x:Key="WarningTextColor">#D9822B</Color>            <!-- Yamabuki-iro -->
  <Color x:Key="WarningBackgroundColor">#FDF3E7</Color>
  <Color x:Key="TextPrimaryColor">#1F2421</Color>            <!-- Sumi-iro -->
  <Color x:Key="TextSecondaryColor">#5C646D</Color>          <!-- Nezumi-iro -->
  <Color x:Key="SidebarTextColor">#F7F6F2</Color>
  <Color x:Key="SidebarMutedTextColor">#B8C0CC</Color>
  <Color x:Key="FrostGlassColor">#2EFFFFFF</Color>            <!-- soft in-app acrylic tint -->
  <Color x:Key="FrostGlassStrongColor">#55FFFFFF</Color>      <!-- readable wash for dark chrome -->
  <Color x:Key="FrostBorderColor">#40FFFFFF</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
  <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}"/>
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
  <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource SidebarBackgroundColor}" Offset="0"/>
    <GradientStop Color="{StaticResource SidebarGradientMidColor}" Offset="0.42"/>
    <GradientStop Color="{StaticResource SidebarGradientHighlightColor}" Offset="0.72"/>
    <GradientStop Color="{StaticResource SidebarGradientDeepColor}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="TitleBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{StaticResource SidebarBackgroundColor}" Offset="0"/>
    <GradientStop Color="{StaticResource SidebarGradientMidColor}" Offset="0.55"/>
    <GradientStop Color="{StaticResource SidebarGradientDeepColor}" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}"/>
  <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}"/>
  <SolidColorBrush x:Key="SelectionTintBrush" Color="{StaticResource SelectionTintColor}"/>
  <SolidColorBrush x:Key="ChassisHighlightBrush" Color="{StaticResource ChassisHighlightColor}"/>
  <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}"/>
  <SolidColorBrush x:Key="DangerBackgroundBrush" Color="{StaticResource DangerBackgroundColor}"/>
  <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}"/>
  <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackgroundColor}"/>
  <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}"/>
  <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
  <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="{StaticResource SidebarMutedTextColor}"/>
  <SolidColorBrush x:Key="FrostGlassBrush" Color="{StaticResource FrostGlassColor}"/>
  <SolidColorBrush x:Key="FrostGlassStrongBrush" Color="{StaticResource FrostGlassStrongColor}"/>
  <SolidColorBrush x:Key="FrostBorderBrush" Color="{StaticResource FrostBorderColor}"/>

  <!-- Align common Wpf.Ui / system resources with Shaken & Washi -->
  <Color x:Key="SystemAccentColorPrimary">#2B4C7E</Color>
  <Color x:Key="SystemAccentColorSecondary">#1F385E</Color>
  <Color x:Key="SystemAccentColorTertiary">#1D5B9E</Color>
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource CardSurfaceColor}"/>
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource BorderSubtleColor}"/>
  <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource PrimaryAccentColor}"/>
  <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource PrimaryAccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource PrimaryAccentColor}"/>
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource PrimaryAccentHoverColor}"/>
  <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{StaticResource SuccessBackgroundColor}"/>
  <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{StaticResource DangerBackgroundColor}"/>
  <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{StaticResource WarningBackgroundColor}"/>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#332B4C7E"/>
  <SolidColorBrush x:Key="OnAccentTextBrush" Color="{StaticResource CardSurfaceColor}"/>

  <!-- Typography: certificate-desk pairing — Yu Gothic for ink, Cascadia for plates -->
  <FontFamily x:Key="DisplayFont">Yu Gothic UI, Meiryo UI, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="BodyFont">Yu Gothic UI, Meiryo UI, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="ChassisMonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

  <!-- ============================================================
       Typography & control styles
       ============================================================ -->

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style TargetType="UserControl">
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
  </Style>

  <!-- Brand wordmark on nav rail -->
  <Style x:Key="BrandDisplayStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
    <Setter Property="Margin" Value="8,8,8,0"/>
  </Style>

  <Style x:Key="BrandEyebrowStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource SidebarMutedTextBrush}"/>
    <Setter Property="Margin" Value="8,0,8,10"/>
  </Style>

  <!--
    In-app frost (Fluent guidance): translucent fill + hairline border.
    Do NOT use WPF BlurEffect on Borders — it softens the control itself and looks muddy.
    True desktop Acrylic needs DWM SystemBackdrop; for nav chrome use this solid-tint wash.
  -->
  <Style x:Key="FrostChromeStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource FrostGlassStrongBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource FrostBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- File / folder paths: Consolas, never Yu Gothic (Yu Gothic draws \ as ¥) -->
  <FontFamily x:Key="PathFont">Consolas, Cascadia Mono, Courier New</FontFamily>

  <Style x:Key="PathTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{StaticResource PathFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Padding" Value="8,7"/>
    <Setter Property="Language" Value="en-US"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <Style x:Key="PathTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource PathFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- Compact icon-only action on status banners -->
  <Style x:Key="StatusIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionTintBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChassisHighlightBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small certificate label above titles -->
  <Style x:Key="EyebrowStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource ChassisHighlightBrush}"/>
    <Setter Property="Margin" Value="0,0,0,0"/>
  </Style>

  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
    <Setter Property="LineHeight" Value="16"/>
  </Style>

  <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>

  <!-- Backward-compatible alias used by older markup -->
  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <Style x:Key="SectionRuleStyle" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>

  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="20"/>
  </Style>

  <Style x:Key="MutedTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="MonoPlateStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ChassisMonoFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource ChassisHighlightBrush}"/>
  </Style>

  <Style x:Key="DetailTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>

  <Style x:Key="StatusMessageStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <!-- Semantic footer banner — bind Border.Tag or use DataTriggers on StatusSeverity -->
  <Style x:Key="StatusBannerStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="Background" Value="{StaticResource SelectionTintBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="StatusBannerSuccessStyle" TargetType="Border" BasedOn="{StaticResource StatusBannerStyle}">
    <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SuccessTextBrush}"/>
  </Style>

  <Style x:Key="StatusBannerWarningStyle" TargetType="Border" BasedOn="{StaticResource StatusBannerStyle}">
    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
  </Style>

  <Style x:Key="StatusBannerErrorStyle" TargetType="Border" BasedOn="{StaticResource StatusBannerStyle}">
    <Setter Property="Background" Value="{StaticResource DangerBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource DangerTextBrush}"/>
  </Style>

  <!-- Strong required-field highlight (Yamabuki wash + border) -->
  <Style x:Key="RequiredFieldHighlightStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="Margin" Value="0,0,0,0"/>
  </Style>

  <Style x:Key="BannerTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="ToolbarCaptionStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>

  <!-- Chassis plate card: Asagi tint + Ruri left accent -->
  <Style x:Key="ChassisPlateCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SelectionTintBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ChassisHighlightBrush}"/>
    <Setter Property="BorderThickness" Value="4,1,1,1"/>
    <Setter Property="CornerRadius" Value="0,8,8,0"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <!-- Multi-model chassis picker (Asagi fill + Ruri border) -->
  <Style x:Key="MultiModelPickerStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SelectionTintBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ChassisHighlightBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <Style x:Key="MultiModelOptionButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChassisHighlightBrush}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionTintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Field highlight when Color/Year/Odometer/Price missing before generate -->
  <Style x:Key="WarningFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WarningTextBrush}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>

  <Style x:Key="VerificationValueCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SelectionTintBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="Margin" Value="0,0,10,10"/>
  </Style>

  <!-- Card surface (generic panels) -->
  <Style x:Key="CardSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <!-- Collapsible source / JP→EN panel -->
  <Style x:Key="SourceTextExpanderStyle" TargetType="Expander">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="ExpandDirection" Value="Down"/>
  </Style>

  <Style x:Key="SourceMonoTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{StaticResource ChassisMonoFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="160"/>
    <Setter Property="MaxHeight" Value="320"/>
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
  </Style>

  <Style x:Key="SuccessBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>

  <Style x:Key="DangerBannerStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DangerBackgroundBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Margin" Value="0,10,0,0"/>
  </Style>

  <Style x:Key="WarningBannerStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>

  <!-- TextBox -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="CaretBrush" Value="{StaticResource ChassisHighlightBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource SelectionTintBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource ChassisHighlightBrush}"/>
      </Trigger>
      <Trigger Property="IsReadOnly" Value="True">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ChassisTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{StaticResource ChassisMonoFont}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource ChassisHighlightBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ChassisHighlightBrush}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
  </Style>

  <!-- ComboBox — MaxDropDownHeight so long lists get a popup ScrollViewer (wheel works via ComboBoxWheelFix) -->
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="MaxDropDownHeight" Value="280"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>

  <!-- Primary / Secondary buttons (standard WPF Button) -->
  <Style x:Key="PrimaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryAccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionTintBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource DangerTextBrush}"/>
  </Style>

  <Style x:Key="NavRailButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- DataGrid: Kachi-iro headers, Asagi selection, click-sort glyphs -->
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="RowBackground" Value="{StaticResource CardSurfaceBrush}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource AppBackgroundBrush}"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderSubtleBrush}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserSortColumns" Value="True"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
  </Style>

  <SolidColorBrush x:Key="SidebarHeaderDividerBrush" Color="{StaticResource SidebarGradientDeepColor}"/>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource SidebarBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="BorderBrush" Value="{StaticResource SidebarHeaderDividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTip" Value="Click to sort"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Border x:Name="HeaderBorder"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource SidebarBackgroundColor}" Offset="0"/>
                <GradientStop Color="{StaticResource SidebarGradientMidColor}" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                RecognizesAccessKey="True"/>
              <TextBlock x:Name="SortGlyph"
                         Grid.Column="1"
                         Text="⇅"
                         Margin="8,0,0,0"
                         FontSize="11"
                         FontFamily="{StaticResource BodyFont}"
                         Foreground="{StaticResource SidebarMutedTextBrush}"
                         VerticalAlignment="Center"
                         Opacity="0.85"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="SortDirection" Value="Ascending">
              <Setter TargetName="SortGlyph" Property="Text" Value="▲"/>
              <Setter TargetName="SortGlyph" Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
              <Setter TargetName="SortGlyph" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="SortDirection" Value="Descending">
              <Setter TargetName="SortGlyph" Property="Text" Value="▼"/>
              <Setter TargetName="SortGlyph" Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
              <Setter TargetName="SortGlyph" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="CanUserSort" Value="False">
              <Setter TargetName="SortGlyph" Property="Visibility" Value="Collapsed"/>
              <Setter Property="Cursor" Value="Arrow"/>
              <Setter Property="ToolTip" Value="{x:Null}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.92"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource SelectionTintBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource SelectionTintBrush}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SelectionTintBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

</ResourceDictionary>
